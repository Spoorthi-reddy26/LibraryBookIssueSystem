# --- Additional ignores for Spring Boot + MySQL ---

# Environment & secrets
.env
.env.*
*.db
*.sql
*.pem
*.crt
*.key

# Logs
*.log
logs/
spring.log

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Dependency folders (if any other languages/tools are used)
node_modules/
__pycache__/
.venv/

# Cache & temporary files
*.tmp
*.swp
*.swo
*.bak
*.cache/
